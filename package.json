{
  "name": "shipnow-backend",
  "version": "1.0.0",
  "description": "API backend profesional para gestión de envíos ShipNow - Entrega Final Coderhouse Backend",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "cross-env NODE_ENV=test mocha --timeout 30000 --exit \"test/**/*.test.js\"",
    "test:watch": "cross-env NODE_ENV=test mocha --watch --timeout 30000 \"test/**/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
